# Copie ce fichier en « secrets.toml » (même dossier) et remplis les valeurs.
# secrets.toml est ignoré par git : ne le commite JAMAIS.

# --- Supabase (Project Settings > API) ---
SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
# Clé « anon / publishable » UNIQUEMENT. Jamais la clé service_role.
SUPABASE_ANON_KEY = "ta-cle-anon"

# --- LLM ---
# Fournisseur : "gemini" ou "claude"
LLM_PROVIDER = "gemini"
# Nom exact du modèle chez le fournisseur choisi (voir sa documentation)
LLM_MODEL = "nom-du-modele"

# Seule la clé du fournisseur utilisé est nécessaire
GEMINI_API_KEY = "ta-cle-gemini"
ANTHROPIC_API_KEY = "ta-cle-anthropic"
